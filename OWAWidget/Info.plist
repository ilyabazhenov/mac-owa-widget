<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hides the app from the Dock — menu bar only -->
    <key>LSUIElement</key>
    <true/>
    <key>CFBundleName</key>
    <string>Mac Owa Widget</string>
    <key>CFBundleDisplayName</key>
    <string>Mac Owa Widget</string>
    <key>CFBundleIdentifier</key>
    <string>com.owawidget.MacOwaWidget</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.5</string>
    <key>CFBundleVersion</key>
    <string>6</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>OWAWidget</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <!--
        Calendar access strings. Both keys are needed: macOS 13 reads
        NSCalendarsUsageDescription, macOS 14+ reads the FullAccess variant.
        A missing string is a crash at request time, not a denial. Localised
        copies live in Resources/*.lproj/InfoPlist.strings.
    -->
    <key>NSCalendarsUsageDescription</key>
    <string>Mac Owa Widget reads the calendars this Mac already syncs so it can show your next meeting and its join link.</string>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>Mac Owa Widget reads the calendars this Mac already syncs so it can show your next meeting and its join link.</string>
    <!-- Required for UNUserNotificationCenter -->
    <key>NSUserNotificationUsageDescription</key>
    <string>Mac Owa Widget notifies you before meetings start so you can join with one click.</string>
    <!--
        App Transport Security is left at its secure defaults (TLS 1.2+, valid chain).
        Self-signed / internal-CA on-premise Exchange servers are supported via an explicit
        user "trust this server" action (TrustedCertificateStore), which pins the leaf
        certificate fingerprint instead of disabling ATS globally.
        If you have a legacy server that requires TLS < 1.2, add a scoped NSExceptionDomains
        entry for that specific hostname here.
    -->
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <!--
        Sparkle auto-update configuration.

        SUFeedURL points to a stable URL on GitHub Releases that always resolves to
        the appcast.xml asset of the latest published release. Each release uploads
        a freshly generated appcast.xml as an asset alongside the .zip.

        SUPublicEDKey holds the Ed25519 public key used to verify update signatures.
        It MUST match the private key stored in Keychain / GitHub Secret SPARKLE_ED_PRIVATE_KEY.
        Run scripts/generate_sparkle_keys.sh once to produce a keypair and paste the
        public key value into the string below.
    -->
    <key>SUFeedURL</key>
    <string>https://github.com/ilyabazhenov/mac-owa-widget/releases/latest/download/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>WPYI42Z1jbfBdFNmyBey6tOcbWyU1x6GGVlmn/nNY/I=</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
</dict>
</plist>
