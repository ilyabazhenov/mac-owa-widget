            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d ч</string>
            <key>few</key>
            <string>%d ч</string>
            <key>many</key>
            <string>%d ч</string>
            <key>other</key>
            <string>%d ч</string>
        </dict>
    </dict>
    <key>unit.meetings</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@meetings@</string>
        <key>meetings</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>one</key>
            <string>%d встреча</string>
            <key>few</key>
