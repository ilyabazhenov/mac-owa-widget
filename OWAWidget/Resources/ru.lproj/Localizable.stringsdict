            <key>many</key>
            <string>%d встреч</string>
            <key>other</key>
            <string>%d встречи</string>
        </dict>
    </dict>
    <key>unit.days</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
